# --- base bruta do CNES -------------------------------------------------------
# 2,82 GB em 109 CSVs, e sete deles passam do limite de 100 MB por arquivo do
# GitHub — o pacote não cabe aqui de forma alguma. Baixe da fonte oficial na
# competência declarada em docs/FICHA_DE_CITACAO.md e confira pelos SHA-256 em
# docs/HASHES_BASE_202606.txt.
BASE_DE_DADOS_CNES_*/
BASE_DE_DADOS_CNES_*.zip

# --- saídas regeneráveis ------------------------------------------------------
# Tudo abaixo sai de `python gera_mapa.py 202606`, e fica de fora por volume.
# Duas saídas são exceção deliberada e ficam versionadas: a pasta web/, que é o
# que o Cloudflare Pages publica, e auditoria_bairros_*.csv, que é a prestação
# de contas das grafias de bairro alteradas em relação à fonte.
mapa_rede_sus_*.html
base_tratada_*.csv

# A versão de produção anterior, de uma página só. Fica à mão no
# computador para conferência, mas não sobe: são 7,9 MB que o site
# não serve mais, e o repositório é público.
v1/

# O dado tratado que o trata_cnes.py entrega ao gera_site.py. É grande e
# regenerável por um comando, como a base tratada logo acima.
dados_tratados.json

# --- ambiente -----------------------------------------------------------------
# Segredos do `wrangler pages dev` nesta máquina (o SEGREDO_IP do report). Em
# produção o segredo mora na configuração da Cloudflare, não em arquivo.
.dev.vars
# Estado local do wrangler: o banco D1 e o bucket R2 de teste desta máquina.
.wrangler/
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.vscode/
.idea/
# Configuração local do Claude Code: o atalho de preview e as skills instaladas
# por projeto. Como rodar o site está no README, e não depende deste arquivo.
.claude/
Thumbs.db
.DS_Store
